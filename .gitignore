# Rust build output, rustfmt backups, and profiling/coverage artifacts.
target/
**/*.rs.bk
*.profraw
*.profdata
/coverage/
/tarpaulin-report.html
# Cargo.lock stays tracked: this workspace ships a CLI application.

# Local environment and credentials. Only sanitized templates belong in Git.
.env
.env.*
!.env.example
!.env.sample
!.env.template
.envrc.local
.cargo/credentials
.cargo/credentials.toml
secrets/
*.key
*.pem
*.p12
*.pfx
*.jks
id_rsa
id_ed25519

# Personal pathwatch settings may contain profile IDs and private endpoints.
/config.toml
/config.local.toml
/pathwatch.toml
/pathwatch.local.toml
/.config/pathwatch/
.pathwatch/

# Live recordings and exports can expose host, source, gateway, and DNS data.
recordings/
pathwatch-recordings/
exports/
captures/
*.jsonl
*.csv
*.pcap
*.pcapng
*.har
*.log
# This reviewed fixture contains synthetic observations, not a live recording.
!/crates/pathwatch-core/tests/golden/schema_v1.jsonl

# Local editors, operating-system metadata, and temporary files.
.idea/
.vscode/
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.tmp
*.bak
